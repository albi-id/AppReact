datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}
// ==================== ENUMS ====================
enum Role {
  USER
  PROFESSIONAL
  ADMIN
}
enum ServiceStatus {
  REQUESTED
  OFFERED
  ACCEPTED
  ARRIVED
  COMPLETED
  CANCELLED
  REJECTED
  PAID
  WAITING
  CHAT
}
enum ProfessionalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}
enum Modality {
  TIME_BASED
  FIXED_PRICE
  HIGHLIGHTED
}
enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}
enum PaymentStatus {
  pending
  approved
  rejected
  in_process
}
enum ProfessionType {
  REGULATED_PROFESSION
  TRADE
}
// ==================== MODELOS =====================
model User {
  id String @id @default(cuid())
  email String @unique
  password String
  role Role @default(USER)
  firstName String?
  lastName String?
  photoUrl String?
  address String?
  lastLocation  Unsupported("gis.geography(Point, 4326)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  provinceId String?
  cityId String?
  paymentMethod PaymentMethod?
  termsAcceptedAt DateTime?
  termsVersion    String?
  province Province? @relation(fields: [provinceId], references: [id])
  city City? @relation(fields: [cityId], references: [id])
  reports  Report[]
  services Service[] @relation("ServiceRequester")
  professional Professional?
  sentMessages Message[] @relation("SentMessages")  
  receivedMessages Message[] @relation("ReceivedMessages")  
  @@map("users")
}
model Professional {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName String
  profession String
  description String?
  phone String?
  address String?
  dniFrontUrl String?
  dniBackUrl String?
  certificateUrl String?
  rating Float @default(0.0)
  reviewCount Int @default(0)
  isActive Boolean @default(false)
  status ProfessionalStatus @default(PENDING)
  modalities Modality[]
  vehicleType String?
  lastLocation  Unsupported("gis.geography(Point, 4326)")?
  lastLocationAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rejectCount     Int      @default(0)
  lastRejectAt    DateTime?
  provinceId String?  
  cityId String?  
  mpUserId         String?
  mpAccessToken    String?
  mpRefreshToken   String?
  mpTokenExpiresAt DateTime?
  mpPkceVerifier String?
  professionalTermsAcceptedAt DateTime?
  professionalTermsVersion    String?
  lateCancelCount Int @default(0)
  professionType   ProfessionType?
  licenseNumber    String?
  credentialUrl String?
  province Province? @relation(fields: [provinceId], references: [id])  
  city City? @relation(fields: [cityId], references: [id])  
  // Relación con servicios donde este profesional es quien presta el servicio
  services Service[] @relation("ServiceProfessional")
  @@map("professionals")
  @@index([provinceId, cityId])
  @@index([isActive, status])
  @@index([profession])
  @@index([lastLocation], type: Gist)   // ← Índice geoespacial clave
}
model Service {
  id String @id @default(cuid())
  requesterId String
  professionalId String?
  type String
  pickupLat Float?
  pickupLng Float?
  pickupLocation Unsupported("gis.geography(Point, 4326)")?
  pickupAddress   String?
  pickupAddressExtra String?    // Ej: "Departamento 3B, 2do piso, timbre negro"
  reference         String?     // "Al lado del supermercado", "Casa con rejas blancas"
  floor             String?     // Piso / Departamento
  doorNumber        String?     // Número de puerta
  provinceId String?  
  cityId String?  
  status ServiceStatus @default(REQUESTED)
  amount Float?
  rating Int?
  review String?
  requestedAt DateTime @default(now())
  acceptedAt DateTime?
  arrivedAt DateTime?
  completedAt DateTime?
  paidAt DateTime?
  rejectAttempts  Int      @default(0)
  rejectedProfessionalIds String[] @default([]) 
  lastRejectAt    DateTime?
  proposedAmount   Float?
  amountProposedAt DateTime?
  requester User @relation("ServiceRequester", fields: [requesterId], references: [id])
  professional Professional? @relation("ServiceProfessional", fields: [professionalId], references: [id])
  messages Message[]   
  totalCharged  Float?
  mpPaymentId   String?
  paymentStatus PaymentStatus?
  paymentModality Modality?
  offeredAt       DateTime?  
  signalPaymentStatus    PaymentStatus?
  signalMpPaymentId      String?
  signalPaidAt           DateTime?
  cancellationChargeStatus     PaymentStatus?
  cancellationChargeMpPaymentId String?
  cancellationChargedAt        DateTime?
  @@map("services")
  @@index([requesterId, status])
  @@index([professionalId, status])
  @@index([requesterId, requestedAt(sort: Desc)])
  @@index([professionalId, requestedAt(sort: Desc)])
  @@index([pickupLocation], type: Gist)   
  @@index([provinceId, cityId])
  
}
model Message {
  id String @id @default(cuid())
  serviceId String
  senderId String
  receiverId String
  content String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sender User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
  @@index([serviceId])
  @@index([senderId])
  @@index([receiverId])
  @@index([serviceId, createdAt]) 
}
model Province {
  id String @id @default(cuid())
  name String @unique
  cities City[]
  users User[]
  professionals Professional[]  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model City {
  id String @id @default(cuid())
  name String
  provinceId String
  province Province @relation(fields: [provinceId], references: [id])
  users User[]
  professionals Professional[]  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([name, provinceId])
}
model Report {
  id                     String       @id @default(cuid())
  reason                 String
  details                String?
  reporterId             String
  reporter               User         @relation(fields: [reporterId], references: [id])
  reportedProfessionalId String?
  serviceId              String?
  platform               String?
  status                 ReportStatus @default(PENDING)
  createdAt              DateTime     @default(now())
}
model PaymentMethod {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  mpCustomerId        String
  mpCardId            String
  cardBrand           String?
  cardLastFour        String?
  cardExpMonth        Int?
  cardExpYear         Int?
  cardPaymentMethodId String?  // ej: "visa", "master"
  linkedAt            DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("payment_methods")
}